# Copy to .env and fill in. .env is git-ignored.

# Required: Tony's brain (Claude Haiku). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Recommended: the New York accent voice (gpt-4o-mini-tts). https://platform.openai.com
# Without it Tony falls back to a free Microsoft voice with no accent.
OPENAI_API_KEY=

# Optional: an ElevenLabs voice instead. Also set tts.elevenlabs_voice_id in config.yaml.
ELEVENLABS_API_KEY=

# A shared password between the ESP32 and this server. Must match TONY_DEVICE_TOKEN in firmware/include/secrets.h.
# Letters and digits only.
DEVICE_TOKEN=change-me
